{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Path Aliases for Monorepo */
    "baseUrl": ".",
    "paths": {
      "@ibp/shared": ["../packages/shared/src/index.ts"],
      "@ibp/shared/*": ["../packages/shared/src/*"],
      "@ibp/solver-ts": ["../packages/solver-ts/src/index.ts"],
      "@ibp/solver-ts/*": ["../packages/solver-ts/src/*"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "../packages/shared/src", "../packages/solver-ts/src"]
}
