{
  "name": "ibp-timetable-generator",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/shared",
    "packages/solver-ts",
    "client",
    "server"
  ],
  "scripts": {
    "install:all": "npm install && npm run bootstrap",
    "bootstrap": "npm run db:generate --workspace=server",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:shared": "npm run build --workspace=@ibp/shared",
    "build:solver-ts": "npm run build --workspace=@ibp/solver-ts",
    "build:packages": "npm run build:shared && npm run build:solver-ts",
    "build:server": "npm run build --workspace=server",
    "build:client": "npm run build --workspace=client",
    "build": "npm run build:packages && npm run build:client",
    "build:all": "npm run build:packages && npm run build:server && npm run build:client",
    "test:shared": "npm run test --workspace=@ibp/shared",
    "test:solver-ts": "npm run test --workspace=@ibp/solver-ts",
    "test:server": "npm run test --workspace=server",
    "test": "npm run test:shared && npm run test:solver-ts && npm run test:server",
    "benchmark": "vitest run benchmarks/benchmark.test.ts",
    "db:migrate": "npm run db:migrate --workspace=server",
    "db:generate": "npm run db:generate --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
